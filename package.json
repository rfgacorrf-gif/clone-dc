{
  "name": "discord-apk-cloner",
  "version": "1.0.0",
  "description": "Discord bot for cloning APK files with Dropbox integration",
  "main": "dist/bot.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot.js",
    "dev": "tsx watch src/bot.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist node_modules",
    "prebuild": "npm run lint"
  },
  "keywords": [
    "discord",
    "apk",
    "cloner",
    "dropbox"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "dropbox": "^10.34.0",
    "sqlite3": "^5.1.6",
    "axios": "^1.6.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "rimraf": "^5.0.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
